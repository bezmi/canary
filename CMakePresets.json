{
    "version": 8,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 29,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CANARY_REQUIRE_VALIDATION": "ON"
            }
        },
        {
            "name": "clang",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "debug",
            "inherits": "default",
            "description": "Debug build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "debug-clang",
            "inherits": [
                "clang",
                "default",
                "debug"
            ],
            "description": "Debug build (clang)"
        },
        {
            "name": "release",
            "inherits": "default",
            "description": "Release build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "release-clang",
            "inherits": [
                "clang",
                "default",
                "release"
            ],
            "description": "Release build (clang)"
        },
        {
            "name": "reldeb",
            "inherits": "default",
            "description": "RelWithDeb build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "reldeb-clang",
            "inherits": [
                "clang",
                "default",
                "reldeb"
            ],
            "description": "RelWithDeb build (clang)"
        },
        {
            "name": "cuda-compile",
            "inherits": "release",
            "description": "Release host validation plus CUDA compilation of the numerical device checks (no device execution); set CMAKE_CUDA_ARCHITECTURES for the target device",
            "cacheVariables": {
                "CANARY_BUILD_BENCHMARKS": "OFF",
                "CANARY_BUILD_CUDA_CHECKS": "ON",
                "CANARY_BUILD_HIP_CHECKS": "OFF"
            }
        },
        {
            "name": "hip-compile",
            "inherits": "release",
            "description": "Release host validation plus HIP compilation of the numerical device checks (no device execution); set CMAKE_HIP_ARCHITECTURES for the target device",
            "cacheVariables": {
                "CANARY_BUILD_BENCHMARKS": "OFF",
                "CANARY_BUILD_CUDA_CHECKS": "OFF",
                "CANARY_BUILD_HIP_CHECKS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "build-debug",
            "configurePreset": "debug",
            "description": "Build Debug (gcc); two jobs by default, override with --parallel",
            "jobs": 2
        },
        {
            "name": "build-release",
            "configurePreset": "release",
            "description": "Build Release (gcc); two jobs by default, override with --parallel",
            "jobs": 2
        },
        {
            "name": "build-reldeb",
            "configurePreset": "reldeb",
            "description": "Build RelWithDebInfo (gcc); two jobs by default, override with --parallel",
            "jobs": 2
        },
        {
            "name": "build-debug-clang",
            "configurePreset": "debug-clang",
            "description": "Build Debug (clang); two jobs by default, override with --parallel",
            "jobs": 2
        },
        {
            "name": "build-release-clang",
            "configurePreset": "release-clang",
            "description": "Build Release (clang); two jobs by default, override with --parallel",
            "jobs": 2
        },
        {
            "name": "build-reldeb-clang",
            "configurePreset": "reldeb-clang",
            "description": "Build RelWithDebInfo (clang); two jobs by default, override with --parallel",
            "jobs": 2
        },
        {
            "name": "build-cuda-compile",
            "configurePreset": "cuda-compile",
            "description": "Build host validation and the CUDA device checks; 16 jobs (about 1.2 GB each) by default, override with --parallel",
            "jobs": 16
        },
        {
            "name": "build-hip-compile",
            "configurePreset": "hip-compile",
            "description": "Build host validation and the HIP device checks; 16 jobs by default, override with --parallel",
            "jobs": 16
        }
    ],
    "workflowPresets": [
        {
            "name": "debug",
            "steps": [
                {
                    "type": "configure",
                    "name": "debug"
                },
                {
                    "type": "build",
                    "name": "build-debug"
                },
                {
                    "type": "test",
                    "name": "test-debug"
                }
            ]
        },
        {
            "name": "release",
            "steps": [
                {
                    "type": "configure",
                    "name": "release"
                },
                {
                    "type": "build",
                    "name": "build-release"
                },
                {
                    "type": "test",
                    "name": "test-release"
                }
            ]
        },
        {
            "name": "reldeb",
            "steps": [
                {
                    "type": "configure",
                    "name": "reldeb"
                },
                {
                    "type": "build",
                    "name": "build-reldeb"
                },
                {
                    "type": "test",
                    "name": "test-reldeb"
                }
            ]
        },
        {
            "name": "debug-clang",
            "steps": [
                {
                    "type": "configure",
                    "name": "debug-clang"
                },
                {
                    "type": "build",
                    "name": "build-debug-clang"
                },
                {
                    "type": "test",
                    "name": "test-debug-clang"
                }
            ]
        },
        {
            "name": "release-clang",
            "steps": [
                {
                    "type": "configure",
                    "name": "release-clang"
                },
                {
                    "type": "build",
                    "name": "build-release-clang"
                },
                {
                    "type": "test",
                    "name": "test-release-clang"
                }
            ]
        },
        {
            "name": "reldeb-clang",
            "steps": [
                {
                    "type": "configure",
                    "name": "reldeb-clang"
                },
                {
                    "type": "build",
                    "name": "build-reldeb-clang"
                },
                {
                    "type": "test",
                    "name": "test-reldeb-clang"
                }
            ]
        },
        {
            "name": "cuda-compile",
            "steps": [
                {
                    "type": "configure",
                    "name": "cuda-compile"
                },
                {
                    "type": "build",
                    "name": "build-cuda-compile"
                },
                {
                    "type": "test",
                    "name": "test-cuda-compile"
                }
            ]
        },
        {
            "name": "hip-compile",
            "steps": [
                {
                    "type": "configure",
                    "name": "hip-compile"
                },
                {
                    "type": "build",
                    "name": "build-hip-compile"
                },
                {
                    "type": "test",
                    "name": "test-hip-compile"
                }
            ]
        }
    ],
    "testPresets": [
        {
            "name": "test-debug",
            "configurePreset": "debug",
            "description": "Run tests with two jobs; override with --parallel",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "jobs": 2,
                "noTestsAction": "error"
            }
        },
        {
            "name": "test-release",
            "configurePreset": "release",
            "description": "Run tests with two jobs; override with --parallel",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "jobs": 2,
                "noTestsAction": "error"
            }
        },
        {
            "name": "test-reldeb",
            "configurePreset": "reldeb",
            "description": "Run tests with two jobs; override with --parallel",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "jobs": 2,
                "noTestsAction": "error"
            }
        },
        {
            "name": "test-debug-clang",
            "configurePreset": "debug-clang",
            "description": "Run tests with two jobs; override with --parallel",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "jobs": 2,
                "noTestsAction": "error"
            }
        },
        {
            "name": "test-release-clang",
            "configurePreset": "release-clang",
            "description": "Run tests with two jobs; override with --parallel",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "jobs": 2,
                "noTestsAction": "error"
            }
        },
        {
            "name": "test-reldeb-clang",
            "configurePreset": "reldeb-clang",
            "description": "Run tests with two jobs; override with --parallel",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "jobs": 2,
                "noTestsAction": "error"
            }
        },
        {
            "name": "test-cuda-compile",
            "configurePreset": "cuda-compile",
            "description": "Run the host tests; the CUDA checks are compiled, not executed. One job; override with --parallel",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "jobs": 1,
                "noTestsAction": "error"
            }
        },
        {
            "name": "test-hip-compile",
            "configurePreset": "hip-compile",
            "description": "Run the host tests; the HIP checks are compiled, not executed. One job; override with --parallel",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "jobs": 1,
                "noTestsAction": "error"
            }
        }
    ]
}
