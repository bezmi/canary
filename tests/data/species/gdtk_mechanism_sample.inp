-- Test input in the layout of GDTk reaction-mechanism files, written for
-- canary's converter test. Rates: Kim and Jo, Int. J. Heat Mass Transf. 169
-- (2021), and Park (1993), in CGS units; the fourth reaction uses Park's
-- rate-controlling temperature T^s T_ve^(1 - s), and the last the electron
-- temperature for both directions.
Config{
   tempLimits = {lower=300.0, upper=30000.0},
}

Reaction{'N2 + N2 <=> N + N + N2',
   fr={'Arrhenius', A=1.216e+20, n=-1.214, C=113200},
   label="N2diss"
}

Reaction{'NO + M <=> N + O + M',
   fr={'Arrhenius', A=1.450e+15, n=0.0, C=75200.0},
   efficiencies={['N2']=1.0, ['O2']=1.0, ['NO']=0.664827586, ['N']=0.664827586, ['O']=0.664827586},
   label="NOdiss",
}

Reaction{'N2 + O <=> NO + N',
   fr={'Arrhenius', A=6.4e17, n=-1.0, C=38400.0},
   br={'Arrhenius', A=1.6e13, n=0.1, C=0.0},
}

Reaction{'O2 + M <=> O + O + M',
   fr={'Park', A=2.0e21, n=-1.5, C=59500.0, s=0.5},
   efficiencies={['N']=5.0, ['O']=5.0},
}

Reaction{'N + e- <=> N+ + e- + e-',
   fr={'Park', A=2.5e34, n=-3.82, C=168600.0, s=0.0, rateControllingTemperature='electron-electronic'},
   br={'fromEqConst', rateControllingTemperature='electron-electronic'},
   label="EII"
}
